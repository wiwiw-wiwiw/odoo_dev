<!-- bank_statement_import/views/bank_statement_import_wizard.xml -->

<odoo>
    <record id="view_bank_statement_import_wizard_form" model="ir.ui.view">
        <field name="name">bank.statement.import.wizard.form</field>
        <field name="model">bank.statement.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Импорт банковской выписки">
                <group>
                    <!-- Поле для выбора парсера -->
                    <field name="bank_parser"/>
                    <!-- Поля для загрузки файла и его имени -->
                    <field name="file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <!-- Кнопка запуска импорта -->
                    <button string="Импортировать" type="object" name="action_import" class="btn-primary"/>
                    <button string="Отмена" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
